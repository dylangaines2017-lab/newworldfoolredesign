---
import Layout from "../../layouts/Layout.astro";
import { tapes, ARG_NOTIFY_EMAIL, ARG_PASSWORD_LENGTH, type Tape } from "../../data/arg";

export function getStaticPaths() {
  return tapes.map((tape) => ({ params: { slug: tape.slug }, props: { tape } }));
}

interface Props {
  tape: Tape;
}

const { tape } = Astro.props;
const tapeNo = String(tape.number).padStart(2, "0");
const caseNo = `77-${tape.slug.toUpperCase()}`;
const marking = "TOP SECRET // ORCON // NOFORN";
---

<Layout
  title={`Case ${caseNo} — Recovered Material`}
  description="Recovered material. Not for distribution."
  noSnap
  bare
  noindex
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>

  <div
    class="feed"
    id="room"
    data-state="boot"
    data-slug={tape.slug}
    data-tape={tapeNo}
    data-email={ARG_NOTIFY_EMAIL}
    data-length={ARG_PASSWORD_LENGTH}
  >
    <!-- Surveillance artifacts over the whole viewport -->
    <canvas class="static" id="static" aria-hidden="true"></canvas>
    <div class="fx scanlines" aria-hidden="true"></div>
    <div class="fx roll" aria-hidden="true"></div>
    <div class="fx vignette" aria-hidden="true"></div>

    <div class="banner banner--top" aria-hidden="true">{marking}</div>
    <div class="banner banner--bottom" aria-hidden="true">{marking}</div>

    <a href="/?home" class="home-btn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      Go to homepage
    </a>

    <div class="osd osd--tl" aria-hidden="true">CAM {tapeNo}</div>
    <div class="osd osd--tr" aria-hidden="true"><span class="rec"><i></i>REC</span></div>
    <div class="osd osd--bl" id="stamp" aria-hidden="true">&nbsp;</div>
    <div class="osd osd--br" id="timecode" aria-hidden="true">00:00:00:00</div>

    <main class="hero" id="hero">
      <header class="dossier">
        <p class="line">DEPARTMENT OF <span class="redact">████████████</span></p>
        <p class="line">OFFICE OF <span class="redact">██████████████████</span></p>
        <p class="line">RECOVERED MATERIAL — TAPE {tapeNo} OF 03</p>
        <p class="line">CASE NO. {caseNo}</p>
        <p class="line">STATUS: <span class="file-status" id="file-status">SEALED</span></p>
      </header>

      <form class="lock" id="lock" autocomplete="off" novalidate>
        <label for="code" class="lock-label">Enter authorization code</label>
        <div class="cells" id="cells">
          {Array.from({ length: ARG_PASSWORD_LENGTH }, () => <span class="cell" aria-hidden="true"></span>)}
          <input
            id="code"
            name="code"
            type="text"
            maxlength={ARG_PASSWORD_LENGTH}
            autocomplete="off"
            autocapitalize="characters"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
            disabled
            data-1p-ignore
            data-lpignore="true"
          />
        </div>
        <p class="status" id="status" role="status" aria-live="polite">Establishing connection…</p>
        <button type="submit" class="submit" id="enter">Submit</button>
      </form>

      <!-- Tape with a film: shown once solved -->
      <div class="monitor" id="film" hidden>
        <span class="monitor-label">Exhibit — recovered footage</span>
        <div class="monitor-frame" id="film-frame"></div>
      </div>

      <div class="solved" id="solved" hidden>
        <p class="accepted">Authorization accepted</p>
        <div class="code" id="solved-code" aria-label="Code"></div>
        <div class="clock" id="clock" role="timer" aria-live="off">24:00:00</div>
        <p class="clock-label">Remaining</p>
      </div>

      <p class="note">Handler note: “{tape.note}”</p>
    </main>

    {tape.videoEmbedUrl && (
      <section class="archive">
        <span class="archive-label">Exhibit A — Tape {tapeNo}</span>
        <div class="archive-frame">
          <iframe
            src={tape.videoEmbedUrl}
            title={`Tape ${tape.number} exhibit`}
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  // NB: don't import src/data/arg.ts here — it holds server-only data.
  const normalize = (s: string) => s.normalize("NFC").trim().toUpperCase();

  interface State {
    solved: boolean;
    password?: string;
    solvedAt?: number;
    endsAt?: number;
    revealEmbedUrl?: string | null;
    now: number;
    firstSolve?: boolean;
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const room = $("room");
  const { slug = "", tape = "", email = "" } = room.dataset;
  const LENGTH = Number(room.dataset.length);
  const api = `/api/footage/${slug}`;
  const notifyKey = `nwf-footage:${slug}:notify`;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const form = $<HTMLFormElement>("lock");
  const input = $<HTMLInputElement>("code");
  const cellsWrap = $("cells");
  const cells = Array.from(cellsWrap.querySelectorAll<HTMLElement>(".cell"));
  const status = $("status");
  const enter = $<HTMLButtonElement>("enter");
  const fileStatus = $("file-status");
  const solvedPanel = $("solved");
  const solvedCode = $("solved-code");
  const clock = $("clock");
  const film = $("film");
  const filmFrame = $("film-frame");
  const stamp = $("stamp");
  const timecode = $("timecode");

  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const pad = (n: number) => String(n).padStart(2, "0");

  type Mode = "boot" | "locked" | "checking" | "wrong" | "burst" | "solved" | "offline";
  const setMode = (mode: Mode) => (room.dataset.state = mode);

  // ── Full-screen static ─────────────────────────────────
  const canvas = $<HTMLCanvasElement>("static");
  const ctx = canvas.getContext("2d")!;
  const W = 320;
  const H = 180;
  canvas.width = W;
  canvas.height = H;
  const frame = ctx.createImageData(W, H);
  const px = new Uint32Array(frame.data.buffer);
  let lastFrame = 0;

  function drawStatic() {
    for (let i = 0; i < px.length; i++) {
      const v = (Math.random() * 255) | 0;
      px[i] = 0xff000000 | (v << 16) | (v << 8) | v;
    }
    ctx.putImageData(frame, 0, 0);
  }

  function loop(t: number) {
    requestAnimationFrame(loop);
    if (t - lastFrame < 40) return; // ~25fps reads more like tape than 60
    lastFrame = t;
    drawStatic();
  }
  drawStatic();
  if (!reduceMotion) requestAnimationFrame(loop);

  /** 0 = clean feed, 1 = nothing but snow */
  const setStatic = (level: number) => room.style.setProperty("--static", String(level));

  // Random signal faults so the feed never feels still.
  function scheduleGlitch() {
    setTimeout(() => {
      const mode = room.dataset.state;
      if (mode === "locked" || mode === "solved") {
        room.classList.add("is-glitch");
        setTimeout(() => room.classList.remove("is-glitch"), 140 + Math.random() * 200);
      }
      scheduleGlitch();
    }, 3500 + Math.random() * 8000);
  }
  if (!reduceMotion) scheduleGlitch();

  // ── Sound (only ever after the visitor types, so browsers allow it) ──
  let audio: AudioContext | null = null;
  function primeAudio() {
    try {
      audio ??= new AudioContext();
      if (audio.state === "suspended") audio.resume();
    } catch {
      audio = null;
    }
  }

  function hiss(seconds: number, volume: number) {
    if (!audio) return;
    const len = Math.floor(audio.sampleRate * seconds);
    const buffer = audio.createBuffer(1, len, audio.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
    const src = audio.createBufferSource();
    src.buffer = buffer;
    const filter = audio.createBiquadFilter();
    filter.type = "highpass";
    filter.frequency.value = 700;
    const gain = audio.createGain();
    const t = audio.currentTime;
    gain.gain.setValueAtTime(0, t);
    gain.gain.linearRampToValueAtTime(volume, t + 0.02);
    gain.gain.setValueAtTime(volume, t + Math.max(0.05, seconds - 0.3));
    gain.gain.linearRampToValueAtTime(0, t + seconds);
    src.connect(filter).connect(gain).connect(audio.destination);
    src.start();
  }

  // ── OSD: date stamp + running timecode ─────────────────
  const loadedAt = performance.now();
  function tickOsd() {
    const d = new Date();
    stamp.textContent = `${pad(d.getMonth() + 1)}/${pad(d.getDate())}/${d.getFullYear()}  ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    const ms = performance.now() - loadedAt;
    const s = Math.floor(ms / 1000);
    timecode.textContent = `${pad(Math.floor(s / 3600))}:${pad(Math.floor((s % 3600) / 60))}:${pad(s % 60)}:${pad(Math.floor((ms % 1000) / 1000 * 30))}`;
  }
  tickOsd();
  setInterval(tickOsd, 1000 / 15);

  // ── Code cells ─────────────────────────────────────────
  function render(value: string) {
    const chars = [...value];
    cells.forEach((cell, i) => {
      cell.textContent = chars[i] ?? "";
      cell.classList.toggle("is-active", i === chars.length && document.activeElement === input);
    });
  }

  // ── Server ─────────────────────────────────────────────
  async function request(init?: RequestInit): Promise<{ res: Response; data: State | null }> {
    const res = await fetch(api, { cache: "no-store", ...init });
    let data: State | null = null;
    try {
      data = (await res.json()) as State;
    } catch {
      // Non-JSON (e.g. the function isn't deployed) — handled by callers.
    }
    return { res, data };
  }

  // ── Solve email (only sent by the browser that solved it first) ──
  function readPendingNotify(): Record<string, string> | null {
    try {
      const raw = localStorage.getItem(notifyKey);
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  async function sendNotify(payload: Record<string, string>) {
    try {
      localStorage.setItem(notifyKey, JSON.stringify(payload));
    } catch {
      // Storage blocked — we just won't be able to retry.
    }
    try {
      const res = await fetch(`https://formsubmit.co/ajax/${email}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      if (res.ok) localStorage.removeItem(notifyKey);
    } catch {
      // Network failure — retried on this browser's next visit.
    }
  }

  // ── Solved: static burst, then the countdown (and the film, if any) ──
  let ticker: number | undefined;
  let revealed = false;

  function startClock(state: State) {
    // Server time, so every visitor sees the same countdown regardless of their clock.
    const offset = state.now - Date.now();
    const endsAt = state.endsAt ?? 0;
    const tick = () => {
      const s = Math.floor(Math.max(0, endsAt - (Date.now() + offset)) / 1000);
      clock.textContent = `${pad(Math.floor(s / 3600))}:${pad(Math.floor((s % 3600) / 60))}:${pad(s % 60)}`;
      if (s === 0) clearInterval(ticker);
    };
    tick();
    ticker = window.setInterval(tick, 250);
  }

  async function reveal(state: State, fromGuess: boolean) {
    if (revealed) return;
    revealed = true;
    clearInterval(poller);
    input.disabled = true;

    // Burst of snow over everything. Longer and louder when it's the visitor's own solve.
    setMode("burst");
    setStatic(1);
    if (fromGuess) hiss(1.6, 0.16);
    await wait(fromGuess ? 1600 : 700);

    solvedCode.innerHTML = "";
    for (const ch of state.password ?? "") {
      const span = document.createElement("span");
      span.textContent = ch;
      solvedCode.append(span);
    }
    startClock(state);
    form.hidden = true;
    solvedPanel.hidden = false;
    fileStatus.textContent = "UNSEALED";

    if (state.revealEmbedUrl) {
      const src = new URL(state.revealEmbedUrl);
      if (fromGuess) src.searchParams.set("autoplay", "1");
      const iframe = document.createElement("iframe");
      iframe.src = src.toString();
      iframe.title = `Tape ${tape}`;
      iframe.allow = "autoplay; fullscreen; picture-in-picture";
      iframe.allowFullscreen = true;
      filmFrame.append(iframe);
      film.hidden = false;
      room.classList.add("has-film");
    }

    setMode("solved");
    setStatic(0.05);

    if (state.firstSolve) {
      sendNotify({
        _subject: `ARG SOLVED — Tape ${tape}`,
        _template: "table",
        _captcha: "false",
        message: `Tape ${tape} of the ARG has been solved.`,
        page: location.href,
        password_entered: state.password ?? "",
        solved_at: new Date(state.solvedAt ?? Date.now()).toString(),
        timer_ends: new Date(state.endsAt ?? 0).toString(),
      });
    }
  }

  function offline(message: string) {
    setMode("offline");
    setStatic(0.3);
    status.textContent = message;
    input.disabled = true;
    enter.disabled = true;
  }

  // ── Guessing ───────────────────────────────────────────
  let busy = false;
  let attempts = 0;
  async function attempt() {
    const candidate = normalize(input.value);
    if (busy || input.disabled) return;
    if ([...candidate].length !== LENGTH) {
      status.textContent = `Code must be ${LENGTH} characters`;
      return;
    }
    primeAudio(); // must happen inside the keypress/click, before any await
    busy = true;
    setMode("checking");
    setStatic(0.2);
    status.textContent = "Verifying…";

    let result: Awaited<ReturnType<typeof request>> | null = null;
    try {
      result = await request({
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password: candidate }),
      });
    } catch {
      // handled below
    }

    if (result?.res.ok && result.data?.solved) {
      busy = false;
      return reveal(result.data, true);
    }

    if (result?.res.status === 401) {
      attempts++;
      setMode("wrong");
      setStatic(0.55);
      hiss(0.35, 0.08);
      status.textContent = `Access denied — attempt ${pad(attempts)} logged`;
      await wait(1400);
      input.value = "";
      render("");
      setMode("locked");
      setStatic(0.07);
      input.focus();
    } else {
      setMode("locked");
      setStatic(0.07);
      status.textContent = "Connection lost — try again";
    }
    busy = false;
  }

  input.addEventListener("input", () => {
    input.value = normalize(input.value).slice(0, LENGTH);
    render(input.value);
    if ([...input.value].length === LENGTH) attempt();
  });
  input.addEventListener("focus", () => render(input.value));
  input.addEventListener("blur", () => render(input.value));
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    attempt();
  });

  // ── Boot: is this tape already solved (by anyone)? ─────
  async function refresh(): Promise<void> {
    try {
      const { res, data } = await request();
      if (!res.ok || !data) return offline("No connection");
      if (data.solved) return reveal(data, false);
      if (room.dataset.state === "boot" || room.dataset.state === "offline") {
        setMode("locked");
        setStatic(0.07);
        input.disabled = false;
        enter.disabled = false;
        status.textContent = "Awaiting input";
      }
    } catch {
      offline("No connection");
    }
  }

  // While unsolved, check occasionally so the page flips live if someone else solves it.
  const poller = window.setInterval(() => {
    if (!busy && !revealed && document.visibilityState === "visible") refresh();
  }, 20_000);

  setStatic(0.6);
  render("");
  wait(reduceMotion ? 0 : 1100).then(refresh);

  const pending = readPendingNotify();
  if (pending) sendNotify(pending);
</script>

<style>
  .feed {
    --static: 0.6;
    --bone: #D9D6CC;
    --dim: rgba(217, 214, 204, 0.42);
    --faint: rgba(217, 214, 204, 0.16);
    --red: #C4271A;
    --green: #3DFF7A;
    position: relative;
    min-height: 100svh;
    background: #000;
    color: var(--bone);
    overflow: hidden;
  }

  .feed [hidden] {
    display: none !important;
  }

  /* ── Artifacts ── */
  .static {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: var(--static);
    transition: opacity 0.4s;
    filter: contrast(1.3);
    pointer-events: none;
  }

  .fx {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  .scanlines {
    z-index: 2;
    background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.4) 2px 3px);
  }

  .roll {
    z-index: 2;
    height: 22vh;
    bottom: auto;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.025) 50%, transparent);
    animation: roll 11s linear infinite;
  }

  @keyframes roll {
    from { transform: translateY(-25vh); }
    to   { transform: translateY(125vh); }
  }

  .vignette {
    z-index: 3;
    background: radial-gradient(ellipse at center, transparent 30%, rgba(0, 0, 0, 0.92) 100%);
  }

  /* ── Classification banners ── */
  .banner {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 0.35rem 1rem;
    text-align: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.35em;
    color: var(--red);
    background: rgba(0, 0, 0, 0.85);
    border-color: rgba(196, 39, 26, 0.35);
    border-style: solid;
    border-width: 0;
  }

  .banner--top {
    top: 0;
    padding-top: calc(env(safe-area-inset-top, 0px) + 0.35rem);
    border-bottom-width: 1px;
  }

  .banner--bottom {
    bottom: 0;
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.35rem);
    border-top-width: 1px;
  }

  /* ── Chrome ── */
  .home-btn {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 2.6rem);
    left: 1.25rem;
    z-index: 11;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bone);
    background: #000;
    border: 1px solid rgba(217, 214, 204, 0.5);
    transition: background 0.15s, color 0.15s;
  }

  .home-btn:hover,
  .home-btn:focus-visible {
    background: var(--bone);
    color: #000;
  }

  /* ── Surveillance OSD ── */
  .osd {
    position: fixed;
    z-index: 9;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--dim);
    text-shadow: 0 0 4px #000;
    white-space: pre;
  }

  .osd--tl { top: calc(env(safe-area-inset-top, 0px) + 6.5rem); left: 1.4rem; }
  .osd--tr { top: calc(env(safe-area-inset-top, 0px) + 2.6rem); right: 1.4rem; padding-top: 0.65rem; }
  .osd--bl { bottom: calc(env(safe-area-inset-bottom, 0px) + 2.4rem); left: 1.4rem; }
  .osd--br { bottom: calc(env(safe-area-inset-bottom, 0px) + 2.4rem); right: 1.4rem; font-variant-numeric: tabular-nums; }

  .rec {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--bone);
  }

  .rec i {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--red);
    animation: blink 1.4s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* ── Content ── */
  .hero {
    position: relative;
    z-index: 5;
    min-height: 100svh;
    width: min(100%, 46rem);
    margin: 0 auto;
    padding: 9rem 1.5rem 7rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3.5rem;
  }

  .has-film .hero {
    width: min(100%, 64rem);
  }

  [data-state="boot"] .hero,
  [data-state="burst"] .hero {
    visibility: hidden;
  }

  /* Lines come up one by one, like a terminal printing */
  [data-state="locked"] .hero > *,
  [data-state="solved"] .hero > * {
    animation: print 0.5s steps(4) both;
  }

  [data-state="locked"] .dossier .line,
  [data-state="solved"] .dossier .line {
    animation: print 0.4s steps(3) both;
  }

  .dossier .line:nth-child(1) { animation-delay: 0.05s; }
  .dossier .line:nth-child(2) { animation-delay: 0.15s; }
  .dossier .line:nth-child(3) { animation-delay: 0.25s; }
  .dossier .line:nth-child(4) { animation-delay: 0.35s; }
  .dossier .line:nth-child(5) { animation-delay: 0.45s; }
  .hero > .lock,
  .hero > .solved,
  .hero > .monitor { animation-delay: 0.6s !important; }
  .hero > .note { animation-delay: 0.9s !important; }

  @keyframes print {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .dossier {
    font-family: "Courier Prime", "Courier New", monospace;
    font-size: clamp(0.85rem, 2.2vw, 1rem);
    line-height: 1.9;
    letter-spacing: 0.06em;
    color: var(--dim);
  }

  .dossier .line:nth-child(3),
  .dossier .line:nth-child(4) {
    color: var(--bone);
  }

  .redact {
    display: inline-block;
    color: transparent;
    background: var(--bone);
    line-height: 1.1;
    user-select: none;
  }

  .is-glitch .redact {
    background: var(--red);
  }

  .file-status {
    color: var(--red);
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  [data-state="solved"] .file-status {
    color: var(--green);
  }

  /* ── Code entry ── */
  .lock {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lock-label,
  .accepted,
  .clock-label,
  .monitor-label,
  .archive-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .cells,
  .code {
    position: relative;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: clamp(0.3rem, 1.4vw, 0.8rem);
  }

  .cell,
  .code :global(span) {
    display: flex;
    align-items: flex-end;
